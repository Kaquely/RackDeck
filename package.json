{
  "name": "homelabmd",
  "version": "1.0.0",
  "private": true,
  "description": "Read-only, real-time dashboard for a homelab of machines and Dockerised applications.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/main.ts",
    "dev:web": "vite",
    "start": "node --env-file-if-exists=.env src/main.ts",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.domtest.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:integration && npm run test:contract && npm run test:scripts",
    "test:unit": "node --test \"tests/unit/**/*.test.ts\"",
    "test:integration": "node --test \"tests/integration/**/*.test.ts\"",
    "test:contract": "node --test \"tests/contract/**/*.test.ts\"",
    "test:scripts": "node --test \"tests/scripts/**/*.test.ts\"",
    "security:audit": "node scripts/security-audit.mjs",
    "security:audit:strict": "node scripts/security-audit.mjs --strict",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run security:audit"
  },
  "dependencies": {
    "express": "^5.2.1",
    "systeminformation": "^5.33.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@happy-dom/global-registrator": "^21.0.4",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "happy-dom": "^21.0.4",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1"
  }
}
