# RackDeck configuration
#
# Copy this file to `.env` and change only what you need.
# Every setting is optional unless the comment says "required".
# If a value is invalid, RackDeck stops at startup and names the setting instead of guessing.
#
# RackDeck is read-only. Nothing in this file can change a machine it watches.

# ---------------------------------------------------------------- runtime

# development, production, or test. Use production for a real deployment.
NODE_ENV=production

# Port the application listens on inside the container. Must be 1-65535.
PORT=3000

# Address to listen on.
#   0.0.0.0   reachable from your local network (default)
#   127.0.0.1 reachable only from this machine
#
# The main dashboard has no login. Only use 0.0.0.0 on a network you trust. A peer node
# protects its read API with HOMELABMD_PEER_TOKEN. Neither role is safe on the internet.
HOMELABMD_HOST=0.0.0.0

# main or peer. The same image serves both roles.
#   main  full dashboard, layout editing, and peer management.
#   peer  read-only API only: no dashboard, no layout edits, no polling of other nodes.
# A peer must set HOMELABMD_PEER_TOKEN. A main must not.
HOMELABMD_ROLE=main

# ---------------------------------------------------------------- collection

# How often RackDeck reads metrics, in milliseconds. 500 means twice per second.
# Minimum 100, maximum 60000.
HOMELABMD_METRICS_INTERVAL_MS=500

# How many samples to keep for each metric. Memory is limited by this number, not by uptime.
# The default of 600 at 500 ms is about five minutes of history.
# Minimum 10, maximum 100000.
HOMELABMD_HISTORY_LENGTH=600

# ---------------------------------------------------------------- storage

# Folder that holds the dashboard layout and the peer list.
HOMELABMD_DATA_DIR=data

# File name for the saved layout. It must not contain a folder path.
HOMELABMD_LAYOUT_FILE=layout.json

# File name for the peer list. It contains bearer tokens, so treat it like a password file.
# On Linux it is created with mode 0600. Back it up with the same care as a credential.
HOMELABMD_PEERS_FILE=peers.json

# Folder with the built web interface. Leave it as is for the container image.
HOMELABMD_STATIC_DIR=dist/web

# ---------------------------------------------------------------- http

# Largest request body RackDeck accepts. The layout is the only thing it writes, so this only
# needs to be larger than the biggest layout you want to save.
HOMELABMD_JSON_BODY_LIMIT=256kb

# ---------------------------------------------------------------- compose only
#
# These three settings are read by `infra/compose.yaml`, not by the application. They are
# listed here so every deployment setting is in one place.

# Port published on the host. The container always listens on port 3000.
HOMELABMD_PUBLISH=3000

# Hard memory limit for the container. If RackDeck goes over it, Docker stops the container.
# The default leaves room below the 300 MB design budget.
HOMELABMD_MEMORY_LIMIT=300m

# Soft memory reservation. Docker uses it as a scheduling hint, not a hard cap.
HOMELABMD_MEMORY_RESERVATION=192m

# ---------------------------------------------------------------- integrations
#
# An integration is enabled by setting its address. Leave it empty and RackDeck runs exactly
# as it did before that integration existed: no source, no requests, no extra setup.
#
# SECRET: HOMELABMD_PIHOLE_PASSWORD is a credential. Put it in the container environment,
# never in a committed file. RackDeck never logs it, never returns it over HTTP, and never
# includes it in an error message.

# Address of the Pi-hole API. Pi-hole v6 serves its API on the web port (8080 by default),
# so this is usually http://<pi-hole>:8080.
# HOMELABMD_PIHOLE_URL=http://pihole.lan:8080

# Password for the Pi-hole API. Leave it empty when Pi-hole has authentication disabled, or
# when a reverse proxy already authenticates for you. A normal Pi-hole v6 install needs it.
# HOMELABMD_PIHOLE_PASSWORD=

# How long to wait for Pi-hole, in milliseconds. This keeps a slow Pi-hole from delaying the
# rest of the dashboard.
# HOMELABMD_PIHOLE_TIMEOUT_MS=5000

# How many rows to show in each top-N table.
# HOMELABMD_PIHOLE_TOP_N=10

# How often to refresh the top-N tables, in milliseconds. This is slower than the normal
# metric interval on purpose: the tables change slowly, and RackDeck usually runs on the same
# small node as Pi-hole. Polling harder would make the dashboard a load on the system it
# watches. The numeric metrics still update every cycle.
# HOMELABMD_PIHOLE_TABLES_INTERVAL_MS=10000

# Name shown for this source in the dashboard header.
# HOMELABMD_PIHOLE_LABEL=Pi-hole

# ---------------------------------------------------------------- peer role
#
# These settings only work when HOMELABMD_ROLE=peer. Setting any of them on a main node stops
# startup, because a main node would advertise protection it does not use.
#
# Shared token. Generate one with:
#   node -e "console.log('hlp_'+require('crypto').randomBytes(32).toString('base64url'))"
# The peer requires it on every data request. The main sends it as `Authorization: Bearer`.
# SECRET: never commit this value and never put it in a URL.
# HOMELABMD_PEER_TOKEN=hlp_replace_with_32_random_bytes

# Optional list of IP addresses or CIDR ranges that may read from this peer, separated by
# commas. When set, the peer accepts reads only from these addresses. It uses the real socket
# address, never the X-Forwarded-For header. Leave empty to rely on the token alone.
# HOMELABMD_PEER_ALLOWED_IPS=192.168.1.10,100.64.0.10

# Stable name reported by /api/peer/info. Defaults to a short version of the host name.
# HOMELABMD_PEER_ID=peer

# ---------------------------------------------------------------- remote nodes
#
# Optional RackDeck peers that the main node reads through their read-only /api/readings
# endpoint. Leave them blank to disable remote nodes. Peers added through the dashboard's
# Nodes dialog are stored in peers.json instead; those cannot be removed from the environment.
# HOMELABMD_REMOTE_NODE_URLS=http://node-a.lan:3000,http://node-b.lan:3000

# Labels for each URL, in the same order. Leave blank to use the host names.
# HOMELABMD_REMOTE_NODE_LABELS=Living room,Office

# Tokens for each URL, in the same order. Use an empty entry for a peer that still allows
# unauthenticated reads. Use a real hlp_ token for a peer that requires one.
# SECRET: keep these out of version control.
# HOMELABMD_REMOTE_NODE_TOKENS=,hlp_replace_with_the_second_peer_token

# How long to wait for each remote node, in milliseconds.
# HOMELABMD_REMOTE_NODE_TIMEOUT_MS=5000

# ---------------------------------------------------------------- update check
#
# RackDeck can tell you when a newer release exists. The check is optional, never downloads an
# update, and sends no installation identifier. It only asks the public GitHub Releases API for
# the repository below and keeps the answer in memory.
#
#   github  ask api.github.com (default)
#   off     make no outbound request
HOMELABMD_UPDATE_CHECK=github

# stable or prerelease. Stable ignores prereleases.
HOMELABMD_UPDATE_CHANNEL=stable

# How often to refresh the cached answer, in milliseconds. Minimum 1000, maximum 604800000
# (seven days). The default is six hours.
HOMELABMD_UPDATE_CHECK_INTERVAL_MS=21600000

# Public repository in owner/name form. Change this only when you run a fork.
HOMELABMD_UPDATE_REPOSITORY=Kaquely/RackDeck

# Container image and exact release tag used by infra/compose.yaml.
# HOMELABMD_IMAGE_TAG is required: Compose fails instead of falling back to an old version.
# The installer sets both values. Never set the tag to `latest`.
HOMELABMD_IMAGE_REPOSITORY=ghcr.io/kaquely/rackdeck
HOMELABMD_IMAGE_TAG=
