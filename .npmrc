# Dependency install scripts are disabled.
#
# npm runs arbitrary code from a package's `install`/`postinstall` script during
# installation. This project depends only on pure-JavaScript packages (Express,
# systeminformation, Vite, TypeScript, ESLint, Prettier), none of which need a build step,
# so blocking scripts costs nothing and removes a supply-chain execution path.
#
# It also keeps `npm audit` runnable here: an inherited `allow-scripts` setting from a
# user-level `.npmrc` otherwise makes npm refuse to run project-scoped commands.
#
# If a future dependency genuinely needs an install script, that is a decision to make
# explicitly and review, not something to enable globally.
allow-scripts=false

# Fail the install rather than silently producing an incomplete tree.
engine-strict=true
